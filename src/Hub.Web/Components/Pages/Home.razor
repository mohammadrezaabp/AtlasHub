@page "/"
<div id="boot" class="boot"><div class="brand-mark">A</div><p>Opening your workspace…</p></div>
<div id="login-view" class="login-page hidden">
    <section class="login-form-wrap" dir="ltr"><div class="login-form-inner"><div class="wordmark">Atlas</div><h2>Sign in</h2><form id="login-form"><label>Work email<input type="email" name="email" autocomplete="username" placeholder="you@organization.com" required /></label><label>Password<input type="password" name="password" autocomplete="current-password" placeholder="Enter your password" required /></label><p id="login-error" class="form-error" role="alert"></p><button type="submit" class="primary wide">Sign in</button></form><p class="login-note">Need an account? Contact your administrator.</p></div></section>
</div>
<div id="app-view" class="app-shell hidden">
    <nav class="chat-rail" aria-label="Main navigation">
        <button id="rail-chat" data-view="chat" class="rail-button" aria-label="Home"><span data-icon="home"></span><span class="rail-label">Home · AI chat</span></button>
        <button data-view="home" class="rail-button" aria-label="Overview"><span data-icon="grid"></span><span class="rail-label">Overview</span></button>
        <button data-view="documents" class="rail-button" aria-label="Knowledge library"><span data-icon="files"></span><span class="rail-label">Knowledge library</span></button>
        <button data-view="search" class="rail-button" aria-label="Search knowledge"><span data-icon="search"></span><span class="rail-label">Search knowledge</span></button>
        <button data-view="approvals" class="rail-button admin-only" aria-label="Approvals"><span data-icon="shield"></span><span class="rail-label">Approvals</span></button>
        <button data-view="system" class="rail-button admin-only" aria-label="System &amp; models"><span data-icon="activity"></span><span class="rail-label">System &amp; models</span></button>
        <button data-view="team" class="rail-button admin-only" aria-label="Team management"><span data-icon="users"></span><span class="rail-label">Team management</span></button>
        <div class="rail-bottom"><button id="account-menu-button" class="rail-button rail-account" aria-label="Account menu" aria-haspopup="menu" aria-controls="account-menu" popovertarget="account-menu"><span id="rail-avatar">A</span><span class="rail-label">Account</span></button></div>
    </nav>
    <aside class="sidebar">
        <div class="chat-panel-heading"><button data-view="chat" class="atlas-home">Atlas</button><button id="toggle-chat-sidebar" class="icon-button" aria-label="Collapse sidebar" title="Collapse sidebar" aria-expanded="true"><span data-icon="panel"></span></button></div>
        <button id="new-chat" class="new-chat-button"><span data-icon="edit"></span> New chat <kbd>Ctrl Shift O</kbd></button>
        <div class="recent-heading"><span>Chats</span><button id="search-chats" class="icon-button" title="Search chats" aria-label="Search chat history"><span data-icon="search"></span></button></div>
        <input id="chat-history-search" class="history-search hidden" type="search" placeholder="Search your chats…" aria-label="Search your chats" />
        <div id="recent-chats" class="recent-chats"><p class="sidebar-empty">Your conversations will appear here.</p></div>
    </aside>
    <div class="workspace-main">
        <header class="topbar"><div class="shell-page-title"><button id="mobile-chats" class="icon-button" aria-label="Open chat history" title="Chat history"><span data-icon="panel"></span></button><h1 id="breadcrumb">Home</h1></div><div class="topbar-actions"><div id="view-actions"></div><button id="quick-search" class="icon-button" title="Search knowledge" aria-label="Search knowledge · Ctrl K"><span data-icon="search"></span></button></div></header>
        <main id="main-content" tabindex="-1"></main>
    </div>
</div>
<div id="account-menu" class="account-menu" popover="auto" role="menu" aria-label="Account"><div class="account-menu-profile"><span id="user-avatar" class="profile-avatar">A</span><div><strong id="user-name">Account</strong><small id="user-role"></small></div></div><button data-view="settings" role="menuitem"><span data-icon="settings"></span>My account</button><button id="theme-toggle" role="menuitem"><span id="theme-icon"></span><span id="theme-label">Light mode</span></button><button id="logout" role="menuitem"><span data-icon="logout"></span>Sign out</button></div>
<dialog id="modal"><button class="modal-close icon-button" aria-label="Close dialog">×</button><div id="modal-body"></div></dialog>
<div id="toast" class="toast hidden" role="status"></div>
<div id="chat-menu" class="chat-menu" popover="auto" role="menu" aria-label="Chat options"><button id="pin-chat" role="menuitem">Pin chat</button><button id="rename-chat" role="menuitem">Rename chat</button><button id="delete-chat" class="delete-menu-item" role="menuitem">Delete chat</button></div>
<input id="image-input" type="file" accept="image/png,image/jpeg,image/webp" class="hidden" />
